# mainnet-beta (default) | devnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Server RPC (keyed provider recommended). Default: public endpoint of the cluster.
SOLANA_RPC_URL=
# The coin's mint. Empty = real zeros everywhere.
NEXT_PUBLIC_MINT=
# Operator wallet secret: base58 or [1,2,...] JSON array. Empty = payouts closed.
OPERATOR_SECRET_KEY=
# 32+ random characters for the session cookie.
SESSION_SECRET=
# SQLite file (default ./data/kudos.db; /tmp on read-only hosts)
KUDOS_DB_PATH=
# Public site URL (metadata)
NEXT_PUBLIC_SITE_URL=
